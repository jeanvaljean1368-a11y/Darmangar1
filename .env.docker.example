# درمانگر - Environment for docker-compose
# این فایل را کپی کنید به .env و مقادیر را پر کنید

# Database
DB_USER=darmanegar
DB_PASSWORD=change-this-to-strong-password
DB_NAME=darmanegar

# JWT Secret (تولید: openssl rand -base64 64)
JWT_SECRET=change-this-to-a-long-random-string-32chars-minimum

# Payment
PAYMENT_PROVIDER=mock
# برای زرین‌پال واقعی:
# PAYMENT_PROVIDER=zarinpal
# ZARINPAL_MERCHANT_ID=your-merchant-id
PAYMENT_CALLBACK_URL=http://localhost

# Admin
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=darmanegar1403

# App URL (برای production دامنه‌ی واقعی را وارد کنید)
NEXT_PUBLIC_APP_URL=http://localhost
