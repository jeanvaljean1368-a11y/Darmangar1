# درمانگر - Production Environment Variables for Vercel
# این مقادیر را در Vercel dashboard → Settings → Environment Variables وارد کنید

# ===== Database (PostgreSQL از Neon) =====
# در neon.tech یک پروژه بسازید و connection string را اینجا قرار دهید
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/darmanegar?sslmode=require"

# ===== JWT Secret =====
# تولید: openssl rand -base64 64
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS_a1b2c3d4e5f6"

# ===== Payment Gateway =====
# فعلاً mock — بعداً به zarinpal تغییر دهید
PAYMENT_PROVIDER="mock"
# برای زرین‌پال واقعی:
# PAYMENT_PROVIDER="zarinpal"
# ZARINPAL_MERCHANT_ID="your-zarinpal-merchant-id"
# آدرس کال‌بک — بعد از deploy اول با آدرس واقعی جایگزین کنید
PAYMENT_CALLBACK_URL="https://your-app.vercel.app/api/payment/callback"

# ===== Admin =====
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="darmanegar1403"

# ===== Application =====
NODE_ENV="production"
# در Vercel نیازی به PORT نیست

# ===== Push Notifications (VAPID keys) =====
